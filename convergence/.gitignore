# Raw convergence run outputs embed full model replies; ignore per-run files.
# Commit a frozen snapshot deliberately (git add -f), not every run. Mirrors
# the top-level results/*.jsonl rule, which is anchored to the repo root and
# does not cover this directory on its own.
results/*.jsonl
results/*.log

# Sampling-variance probe outputs (full model replies per probe run).
probe_reports/

# Analysis artifacts are deterministic and regenerable; a frozen result is
# committed deliberately with git add -f (claude_code_handoff_analysis.md,
# Output).
analysis/

# Instrument characterization outputs (compare-runs); not analysis artifacts.
analysis_runs/
